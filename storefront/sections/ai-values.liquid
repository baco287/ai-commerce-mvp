{%- comment -%}
  AI Commerce: „Warum Yakaru“ – kurze Markenwerte. Bewusst ohne Garantien, Lieferzusagen,
  Bewertungen oder Siegel; Texte im Theme-Editor änderbar.
{%- endcomment -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width ai-values">
    {%- if section.settings.title != blank -%}
      <h2 class="ai-values__title h2">{{ section.settings.title }}</h2>
    {%- endif -%}
    <ul class="ai-values__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="ai-values__item" {{ block.shopify_attributes }}>
          <span class="ai-values__number" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
          <h3 class="ai-values__heading h4">{{ block.settings.heading }}</h3>
          <div class="ai-values__text rte">{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  /* .page-width im Selektor: Dawns „.page-width { padding: 0 … }“ würde sonst den Abstand überschreiben */
  .page-width.ai-values {
    padding-top: 4.8rem;
    padding-bottom: 4.8rem;
  }
  .ai-values__title {
    margin: 0 0 2.8rem;
  }
  .ai-values__grid {
    display: grid;
    gap: 2.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ai-values__item {
    padding-top: 1.6rem;
    border-top: 0.2rem solid rgba(var(--color-button), 0.6);
  }
  .ai-values__number {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.1rem;
    color: rgb(var(--color-button));
  }
  .ai-values__heading {
    margin: 0.6rem 0 0.8rem;
  }
  .ai-values__text {
    font-size: 1.5rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.78);
  }
  @media screen and (min-width: 750px) {
    .ai-values__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 3.2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Yakaru Werte",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "title", "label": "Überschrift", "default": "Warum Yakaru" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Wert",
      "settings": [
        { "type": "text", "id": "heading", "label": "Überschrift", "default": "Überschrift" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Yakaru Werte" }]
}
{% endschema %}
