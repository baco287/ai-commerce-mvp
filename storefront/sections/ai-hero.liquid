{%- comment -%}
  AI Commerce: Startseiten-Hero für Yakaru – Text links, Illustration rechts (assets/yakaru-hero.svg).
  Alle Texte und Links sind im Theme-Editor änderbar. Optional kann ein eigenes Bild hochgeladen werden.
{%- endcomment -%}

<div class="ai-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width ai-hero__inner">
    <div class="ai-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ai-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="ai-hero__heading h0">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="ai-hero__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="ai-hero__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}" class="button">
            {{- section.settings.button_label_1 -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: routes.collections_url }}" class="button button--secondary">
            {{- section.settings.button_label_2 -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <figure class="ai-hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 50vw, 100vw', class: 'ai-hero__image'
        }}
      {%- else -%}
        <img
          src="{{ 'yakaru-hero.svg' | asset_url }}"
          alt="Illustration: LED-Lichtleiste, Laptopständer und Trinkflaschen"
          width="1000"
          height="800"
          class="ai-hero__image"
          fetchpriority="high"
        >
        <figcaption class="ai-hero__caption">Illustrationen · Symbolbilder</figcaption>
      {%- endif -%}
    </figure>
  </div>
</div>

{% stylesheet %}
  .ai-hero {
    overflow: hidden;
  }
  /* .page-width im Selektor: Dawns „.page-width { padding: 0 … }“ würde sonst den Abstand überschreiben */
  .page-width.ai-hero__inner {
    display: grid;
    gap: 3.2rem;
    align-items: center;
    padding-top: 4.8rem;
    padding-bottom: 4.8rem;
  }
  .ai-hero__eyebrow {
    margin: 0 0 1.2rem;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.14rem;
    text-transform: uppercase;
    color: rgb(var(--color-button));
  }
  .ai-hero__heading {
    margin: 0;
    line-height: 1.1;
  }
  .ai-hero__text {
    margin-top: 1.6rem;
    max-width: 52rem;
    font-size: 1.7rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.82);
  }
  .ai-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.8rem;
  }
  .ai-hero__media {
    margin: 0;
    position: relative;
  }
  .ai-hero__image {
    display: block;
    width: 100%;
    height: auto;
    max-width: 62rem;
    margin-inline: auto;
  }
  .ai-hero__caption {
    margin-top: 0.4rem;
    text-align: right;
    font-size: 1.1rem;
    color: rgba(var(--color-foreground), 0.55);
  }
  @media screen and (min-width: 990px) {
    .page-width.ai-hero__inner {
      grid-template-columns: 1.05fr 1fr;
      gap: 4.8rem;
      padding-top: 6.4rem;
      padding-bottom: 6.4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Yakaru Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Überzeile", "default": "Yakaru" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Durchdachte Produkte für jeden Tag" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label_1", "label": "Button 1 – Text", "default": "Alle Produkte" },
    { "type": "url", "id": "button_link_1", "label": "Button 1 – Link" },
    { "type": "text", "id": "button_label_2", "label": "Button 2 – Text", "default": "Kategorien" },
    { "type": "url", "id": "button_link_2", "label": "Button 2 – Link" },
    { "type": "image_picker", "id": "image", "label": "Eigenes Bild (ersetzt die Illustration)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-3" }
  ],
  "presets": [{ "name": "Yakaru Hero" }]
}
{% endschema %}
