{
  "name": "ai-commerce-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "tsx scripts/check-public-data.ts",
    "build": "next build",
    "prestart": "tsx scripts/check-public-data.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "shopify:csv": "vitest run -u src/lib/shopify/csv-export.test.ts",
    "shopify:sync": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/shopify-sync.ts",
    "suppliers:import": "tsx --conditions=react-server scripts/supplier-import.ts",
    "market:scan": "tsx --conditions=react-server scripts/market-scan.ts",
    "pipeline:dry-run": "tsx --conditions=react-server scripts/market-scan.ts --save"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
