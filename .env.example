# Vorlage für Zugangsdaten. Kopieren nach .env.local und dort ausfüllen.
# .env und .env.* (außer dieser Datei) werden von Git ignoriert – niemals echte Werte committen.
#
# Ohne Einträge läuft das Dashboard komplett mit Demodaten; die Shopify-Ansicht zeigt dann
# Einrichtungshinweise.

# Shopify – Dev Dashboard App mit NUR read_products, read_inventory, write_products, write_inventory
# (Schreiben nur über npm run shopify:sync mit fester Positivliste; keine Bestell-/Veröffentlichungsrechte)
# Anleitung: docs/SHOPIFY-API-EINRICHTUNG.md
SHOPIFY_STORE_DOMAIN=yakru.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Datenbank (Phase 2)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_commerce

# KI-Agenten (erst nach Budgetfreigabe; SAFETY_SWITCHES.paidApiCallsEnabled bleibt bis dahin false)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# n8n (Automationen)
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=
