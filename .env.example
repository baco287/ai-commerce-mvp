# Vorlage für spätere Zugangsdaten. Kopieren nach .env.local und dort ausfüllen.
# .env und .env.* (außer dieser Datei) werden von Git ignoriert – niemals echte Werte committen.
#
# Phase 1 benötigt KEINE dieser Variablen: das Dashboard läuft komplett mit Demodaten.

# Datenbank (Phase 2)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_commerce

# KI-Agenten (erst nach Budgetfreigabe; SAFETY_SWITCHES.paidApiCallsEnabled bleibt bis dahin false)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Shopify (Store Manager Agent)
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_ADMIN_ACCESS_TOKEN=

# n8n (Automationen)
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=
